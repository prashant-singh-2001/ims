<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.reports.StockReportController"
            styleClass="app-root">

    <top>
        <VBox styleClass="screen-actions">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="24" bottom="6" left="24"/></padding>
                <Button text="Export CSV" onAction="#onExportCsvClicked"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="0" right="24" bottom="14" left="24"/></padding>
                <ComboBox fx:id="categoryFilterCombo"/>
                <ComboBox fx:id="locationFilterCombo"/>
                <ComboBox fx:id="agingBucketFilterCombo"/>
                <Button text="Search" onAction="#onSearchClicked"/>
                <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>

            <Label text="Aging" styleClass="section-heading"/>
            <HBox spacing="16">
                <VBox spacing="4" styleClass="wizard-callout">
                    <Label text="0-30 days" styleClass="field-label"/>
                    <Label fx:id="age0To30Label"/>
                </VBox>
                <VBox spacing="4" styleClass="wizard-callout">
                    <Label text="31-60 days" styleClass="field-label"/>
                    <Label fx:id="age31To60Label"/>
                </VBox>
                <VBox spacing="4" styleClass="wizard-callout">
                    <Label text="61-90 days" styleClass="field-label"/>
                    <Label fx:id="age61To90Label"/>
                </VBox>
                <VBox spacing="4" styleClass="alert-surface">
                    <Label text="90+ days (dead stock)" styleClass="text-danger"/>
                    <Label fx:id="age90PlusLabel"/>
                </VBox>
            </HBox>

            <HBox spacing="30" alignment="CENTER_LEFT">
                <Label text="Grand total value:" styleClass="field-label"/>
                <Label fx:id="grandTotalLabel"/>
                <Label text="Total pieces:" styleClass="field-label"/>
                <Label fx:id="totalPieceCountLabel"/>
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="130"/>
                    <TableColumn fx:id="modelColumn" text="Model" prefWidth="200"/>
                    <TableColumn fx:id="modelCodeColumn" text="Code" prefWidth="90"/>
                    <TableColumn fx:id="pieceCountColumn" text="Pieces" prefWidth="70"/>
                    <TableColumn fx:id="totalValueColumn" text="Total Value" prefWidth="110"/>
                    <TableColumn fx:id="oldestAgeColumn" text="Oldest (days)" prefWidth="100"/>
                    <TableColumn fx:id="actionsColumn" text="" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
