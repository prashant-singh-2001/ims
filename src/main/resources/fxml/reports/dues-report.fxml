<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.furnitureims.ui.reports.DuesReportController"
            styleClass="app-root">

    <top>
        <VBox styleClass="screen-actions">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="14" right="24" bottom="6" left="24"/></padding>
                <Button text="Export CSV" onAction="#onExportCsvClicked"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="0" right="24" bottom="14" left="24"/></padding>
                <TextField fx:id="searchField" promptText="Search name or phone" prefWidth="180"/>
                <ComboBox fx:id="bucketFilterCombo"/>
                <Label text="Min amount"/>
                <TextField fx:id="minimumAmountField" prefWidth="100"/>
                <Button text="Search" onAction="#onSearchClicked"/>
                <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Customer Dues">
                <TableView fx:id="customerTable"/>
            </Tab>
            <Tab text="Supplier Dues">
                <TableView fx:id="supplierTable"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
