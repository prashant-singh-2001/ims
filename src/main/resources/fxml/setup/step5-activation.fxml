<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.furnitureims.ui.setup.Step5ActivationController">
    <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

    <Label text="Activate This Copy" styleClass="wizard-step-title"/>
    <Label text="Enter the activation key you were given to bind this installation to this PC. Setup cannot finish without it."
           wrapText="true" styleClass="wizard-step-subtitle"/>

    <VBox spacing="10" styleClass="wizard-callout">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Activation key" minWidth="130"/>
            <TextField fx:id="activationKeyField" promptText="FIMS-XXXX-XXXX-XXXX" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="activateButton" text="Activate" onAction="#onActivateClicked"/>
            <ProgressIndicator fx:id="progressIndicator" prefWidth="20" prefHeight="20"/>
            <Label fx:id="statusLabel"/>
        </HBox>
        <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
    </VBox>

    <Label text="This requires an internet connection once, here at setup. After that the app works fully offline for weeks at a time - it only needs to reconnect occasionally to renew automatically in the background."
           wrapText="true" styleClass="wizard-step-subtitle"/>
</VBox>
