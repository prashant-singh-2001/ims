<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.furnitureims.ui.setup.Step1ShopProfileController">
    <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

    <Label text="Shop Profile" styleClass="wizard-step-title"/>
    <Label text="This appears on every invoice, credit note and debit note the shop issues."
           wrapText="true" styleClass="wizard-step-subtitle"/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="160"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Shop name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="shopNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Address line 1" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="addressLine1Field" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Address line 2" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="addressLine2Field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="City" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="cityField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Pincode" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="pincodeField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="State *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="stateCombo" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"
                  promptText="Select the shop's state"/>

        <Label text="GST registered?" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <CheckBox fx:id="gstRegisteredCheck" text="This shop is GST-registered" selected="true"
                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <!-- M10: GST-only - hidden together when the shop above says it isn't registered.
             State (above) stays required either way - it's an address field this app also
             prints on documents, GST or not. -->
        <Label fx:id="gstinLabel" text="GSTIN *" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="gstinField" GridPane.rowIndex="7" GridPane.columnIndex="1"
                   promptText="22AAAAA0000A1Z5"/>

        <Label fx:id="registrationTypeLabel" text="GST registration *" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <HBox fx:id="registrationTypeBox" spacing="16" GridPane.rowIndex="8" GridPane.columnIndex="1">
            <fx:define>
                <ToggleGroup fx:id="registrationTypeGroup"/>
            </fx:define>
            <RadioButton fx:id="regularRadio" text="Regular" selected="true" toggleGroup="$registrationTypeGroup"/>
            <RadioButton fx:id="compositionRadio" text="Composition" toggleGroup="$registrationTypeGroup"/>
        </HBox>

        <Label text="Phone *" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <Label text="Email" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
    </GridPane>
</VBox>
