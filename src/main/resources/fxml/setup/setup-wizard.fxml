<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.setup.SetupWizardController"
            styleClass="app-root">

    <top>
        <VBox spacing="4" styleClass="wizard-header">
            <padding><Insets top="16" right="24" bottom="12" left="24"/></padding>
            <Label text="PieceTrack - Setup" styleClass="wizard-header-title"/>
            <Label fx:id="stepIndicatorLabel" styleClass="wizard-header-subtitle"/>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentPane">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
            <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="backButton" text="Back" onAction="#onBackClicked"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextClicked" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
