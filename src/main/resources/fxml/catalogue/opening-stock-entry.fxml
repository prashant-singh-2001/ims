<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.furnitureims.ui.catalogue.OpeningStockEntryController"
            styleClass="app-root">

    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
            <Label text="One row per model. Each row creates that many individually tagged, individually costed pieces. Use &quot;+ New Item&quot; to add stock for something not in the catalogue yet - it creates the item model for you."
                   wrapText="true" styleClass="wizard-step-subtitle"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="rowsBox" spacing="8"/>
            </ScrollPane>
            <HBox spacing="10">
                <Button text="+ Add Row" onAction="#onAddRowClicked"/>
                <Button text="+ New Item" onAction="#onAddNewItemRowClicked"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
            <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            <Button text="Save All" onAction="#onSaveAllClicked" styleClass="primary-button"/>
        </VBox>
    </bottom>
</BorderPane>
