<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.furnitureims.ui.catalogue.OpeningStockEntryController"
            styleClass="app-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="wizard-header">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="Opening Stock Entry" styleClass="wizard-header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Register" onAction="#onBackClicked"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
            <Label text="One row per model. Each row creates that many individually tagged, individually costed pieces."
                   wrapText="true" styleClass="wizard-step-subtitle"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="rowsBox" spacing="8"/>
            </ScrollPane>
            <Button text="+ Add Row" onAction="#onAddRowClicked"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
            <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            <Button text="Save All" onAction="#onSaveAllClicked" styleClass="primary-button"/>
        </VBox>
    </bottom>
</BorderPane>
