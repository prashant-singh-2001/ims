<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.furnitureims.ui.catalogue.CategoriesLocationsController"
            styleClass="app-root">

    <center>
        <HBox spacing="24">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Categories" styleClass="section-heading"/>
                <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="categoryNameColumn" text="Name" prefWidth="220"/>
                        <TableColumn fx:id="categoryActiveColumn" text="Active" prefWidth="70"/>
                        <TableColumn fx:id="categoryActionsColumn" text="" prefWidth="90"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <TextField fx:id="newCategoryField" promptText="New category name" HBox.hgrow="ALWAYS"/>
                    <Button text="Add" onAction="#onAddCategoryClicked"/>
                </HBox>
                <Label fx:id="categoryErrorLabel" styleClass="wizard-error-label" wrapText="true"/>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Storage Locations" styleClass="section-heading"/>
                <TableView fx:id="locationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="locationNameColumn" text="Name" prefWidth="220"/>
                        <TableColumn fx:id="locationActiveColumn" text="Active" prefWidth="70"/>
                        <TableColumn fx:id="locationActionsColumn" text="" prefWidth="90"/>
                    </columns>
                </TableView>
                <HBox spacing="8">
                    <TextField fx:id="newLocationField" promptText="New location name" HBox.hgrow="ALWAYS"/>
                    <Button text="Add" onAction="#onAddLocationClicked"/>
                </HBox>
                <Label fx:id="locationErrorLabel" styleClass="wizard-error-label" wrapText="true"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
