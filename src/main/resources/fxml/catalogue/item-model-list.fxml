<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.catalogue.ItemModelListController"
            styleClass="app-root">

    <top>
        <VBox styleClass="screen-actions">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="16" right="24" bottom="8" left="24"/></padding>
                <Button text="Categories &amp; Locations" onAction="#onCategoriesLocationsClicked"/>
                <Button text="New Model" onAction="#onNewClicked" styleClass="primary-button"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
                <TextField fx:id="searchField" promptText="Search name, code, material, colour" prefWidth="280"/>
                <ComboBox fx:id="categoryFilterCombo" promptText="All categories"/>
                <CheckBox fx:id="activeOnlyCheck" text="Active only"/>
                <Button text="Search" onAction="#onSearchClicked"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="codeColumn" text="Code" prefWidth="80"/>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="110"/>
                <TableColumn fx:id="hsnColumn" text="HSN" prefWidth="70"/>
                <TableColumn fx:id="gstColumn" text="GST" prefWidth="60"/>
                <TableColumn fx:id="priceColumn" text="Default Price" prefWidth="100"/>
                <TableColumn fx:id="stockColumn" text="In Stock" prefWidth="70"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                <TableColumn fx:id="actionsColumn" text="" prefWidth="260"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
