<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.shell.DashboardController"
            styleClass="app-root" fitToWidth="true">
    <VBox spacing="20">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

        <Label fx:id="welcomeLabel" styleClass="text-muted"/>

        <!-- Stock leads: this is an inventory management system first (M10). -->
        <Label text="Stock" styleClass="section-heading"/>
        <HBox spacing="12">
            <VBox spacing="4" styleClass="metric-tile" onMouseClicked="#onStockValueTileClicked">
                <Label text="Stock Value" styleClass="metric-tile-label"/>
                <Label fx:id="stockValueLabel" styleClass="metric-tile-value"/>
            </VBox>
            <VBox fx:id="piecesInStockTile" spacing="4" styleClass="metric-tile" onMouseClicked="#onStockValueTileClicked">
                <Label text="Pieces in Stock" styleClass="metric-tile-label"/>
                <Label fx:id="piecesInStockLabel" styleClass="metric-tile-value"/>
            </VBox>
        </HBox>

        <Label text="Quick Actions" styleClass="section-heading"/>
        <HBox spacing="12">
            <Button text="New Sale" onAction="#onNewSaleClicked" styleClass="primary-button"/>
            <Button text="New Purchase Bill" onAction="#onNewPurchaseBillClicked" styleClass="primary-button"/>
            <Button text="Payments" onAction="#onPaymentsClicked" styleClass="primary-button"/>
        </HBox>

        <!-- Sales and money: secondary, below stock (M10). -->
        <Label text="Sales and Money" styleClass="section-heading"/>
        <HBox spacing="12">
            <VBox spacing="4" styleClass="metric-tile" onMouseClicked="#onTodaySalesTileClicked">
                <Label text="Today's Sales" styleClass="metric-tile-label"/>
                <Label fx:id="todaySalesLabel" styleClass="metric-tile-value"/>
            </VBox>
            <VBox spacing="4" styleClass="metric-tile" onMouseClicked="#onMonthSalesTileClicked">
                <Label text="This Month's Sales" styleClass="metric-tile-label"/>
                <Label fx:id="monthSalesLabel" styleClass="metric-tile-value"/>
            </VBox>
            <VBox spacing="4" styleClass="metric-tile" onMouseClicked="#onReceivableTileClicked">
                <Label text="Receivable" styleClass="metric-tile-label"/>
                <Label fx:id="receivableLabel" styleClass="metric-tile-value"/>
            </VBox>
            <VBox spacing="4" styleClass="metric-tile" onMouseClicked="#onPayableTileClicked">
                <Label text="Payable" styleClass="metric-tile-label"/>
                <Label fx:id="payableLabel" styleClass="metric-tile-value"/>
            </VBox>
            <VBox fx:id="backupStatusTile" spacing="4" styleClass="metric-tile" onMouseClicked="#onBackupStatusTileClicked">
                <Label text="Backup Status" styleClass="metric-tile-label"/>
                <Label fx:id="backupStatusLabel"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
