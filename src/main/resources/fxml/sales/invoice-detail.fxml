<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.sales.InvoiceDetailController"
            styleClass="app-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="screen-actions">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Button fx:id="returnButton" text="Return Pieces" onAction="#onReturnClicked"/>
            <Button fx:id="cancelButton" text="Cancel Invoice" onAction="#onCancelClicked"/>
            <Button text="Generate PDF" onAction="#onGeneratePdfClicked"/>
            <Button fx:id="openPdfButton" text="Open PDF" onAction="#onOpenPdfClicked"/>
            <Button fx:id="whatsAppButton" text="WhatsApp" onAction="#onWhatsAppClicked"/>
            <Button fx:id="emailButton" text="Email" onAction="#onEmailClicked"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <GridPane hgap="20" vgap="6">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="200"/>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="150"/>
                </columnConstraints>
                <Label text="Customer" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="customerLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label fx:id="placeOfSupplyHeading" text="Place of supply" styleClass="field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Label fx:id="placeOfSupplyLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Status" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="statusLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Grand total" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label fx:id="grandTotalLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Balance" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="balanceLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>

            <Label text="Items" styleClass="section-heading"/>
            <TableView fx:id="linesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tagColumn" text="Tag" prefWidth="90"/>
                    <TableColumn fx:id="descriptionColumn" text="Item" prefWidth="200"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="90"/>
                    <TableColumn fx:id="discountColumn" text="Discount" prefWidth="90"/>
                    <TableColumn fx:id="taxableColumn" text="Taxable" prefWidth="90"/>
                    <TableColumn fx:id="taxColumn" text="Tax" prefWidth="90"/>
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
