<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.purchase.PurchaseBillListController"
            styleClass="app-root">

    <top>
        <VBox styleClass="screen-actions">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="16" right="24" bottom="8" left="24"/></padding>
                <Button text="Suppliers" onAction="#onSuppliersClicked"/>
                <Button text="New Purchase Bill" onAction="#onNewClicked" styleClass="primary-button"/>
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <padding><Insets top="0" right="24" bottom="16" left="24"/></padding>
                <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="billNoColumn" text="Bill #" prefWidth="110"/>
                <TableColumn fx:id="supplierColumn" text="Supplier" prefWidth="170"/>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                <TableColumn fx:id="totalColumn" text="Total" prefWidth="110"/>
                <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="110"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                <TableColumn fx:id="actionsColumn" text="" prefWidth="260"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
