<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.purchase.PurchaseReturnController"
            styleClass="app-root">

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="12">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <Label text="Pieces still in stock from this bill" styleClass="field-label"/>
                <VBox fx:id="pieceCheckboxesBox" spacing="8"/>

                <Label text="Reason *" styleClass="field-label"/>
                <TextField fx:id="reasonField"/>

                <Label text="Return date" styleClass="field-label"/>
                <DatePicker fx:id="returnDatePicker"/>

                <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
                <Button text="Submit Return" onAction="#onSubmitClicked" styleClass="primary-button"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
