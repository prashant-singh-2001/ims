<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.piecetrack.ui.purchase.SupplierEditorController"
            styleClass="app-root">

    <center>
        <VBox spacing="10">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Supplier name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label fx:id="gstinLabel" text="GSTIN" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <VBox fx:id="gstinBox" spacing="4" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="gstinField" promptText="22AAAAA0000A1Z5"/>
                    <Label fx:id="gstinWarningLabel" styleClass="wizard-warning-text" wrapText="true"/>
                </VBox>

                <Label text="Address line 1" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="addressLine1Field" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Address line 2" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="addressLine2Field" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="City" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="cityField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Pincode" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="pincodeField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label fx:id="stateLabel" text="State *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="stateCombo" GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity"
                          promptText="Decides CGST/SGST vs IGST on purchases"/>

                <Label text="Phone" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Email" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <Label text="Contact person" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <TextField fx:id="contactPersonField" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                <Label text="Opening balance owed" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <TextField fx:id="openingBalanceField" GridPane.rowIndex="10" GridPane.columnIndex="1"
                           promptText="Rupees owed before this system was in use"/>

                <Label text="Active" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                <CheckBox fx:id="activeCheck" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

                <Label text="Notes" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                <TextArea fx:id="notesArea" GridPane.rowIndex="12" GridPane.columnIndex="1" prefRowCount="3"/>
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="8" right="24" bottom="16" left="24"/></padding>
            <Label fx:id="errorLabel" styleClass="wizard-error-label" wrapText="true"/>
            <Button text="Save" onAction="#onSaveClicked" styleClass="primary-button"/>
        </VBox>
    </bottom>
</BorderPane>
