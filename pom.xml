<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.furnitureims</groupId>
    <artifactId>inventory-management-system</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Furniture Shop Inventory Management System</name>
    <description>Windows desktop inventory, GST billing and backup system for a furniture retail shop</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>26.0.2</javafx.version>
        <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <openpdf.version>3.0.5</openpdf.version>
        <jna.version>5.19.1</jna.version>
        <google-api-client.version>2.9.0</google-api-client.version>
        <google-oauth-client.version>1.39.0</google-oauth-client.version>
        <google-api-services-drive.version>v3-rev20240914-2.0.0</google-api-services-drive.version>
        <!-- Single-target platform: this app ships to Windows only (NFR-01) -->
        <javafx.platform>win</javafx.platform>
    </properties>

    <dependencies>
        <!-- Core Spring context: DI, @Scheduled, @Transactional. No web starter - this is a desktop app. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- JdbcTemplate + DataSource + PlatformTransactionManager. Plain JDBC, not JPA:
             SQLite's Hibernate dialect support is patchy, and the schema in docs/02-data-model.md
             is already SQL-first with paisa-integer money columns, which maps directly onto
             JdbcTemplate + hand-written POJOs without an ORM layer in between. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- BCryptPasswordEncoder only - not the full security starter, which is built for
             web filter chains this desktop app has no use for. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!-- PDF generation for FR-DOC-01/05 (invoices, credit notes, debit notes). LGPL/MPL,
             pure Java, no native deps - unlike iText 7+ this carries no AGPL/commercial
             licensing concern for a tool sold to a shop. Package is org.openpdf.* since 3.0. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <!-- SMTP send for FR-DOC-04. Only used for JavaMailSenderImpl/MimeMessageHelper -
             SMTP host/port/credentials are user-configurable at runtime (settings screen),
             so this app never relies on Spring Boot's static-properties mail autoconfiguration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Spring Boot 4 modularised Flyway autoconfiguration out of spring-boot-autoconfigure;
             this starter is what actually registers FlywayAutoConfiguration and pulls in a
             Boot-compatible flyway-core version. SQLite dialect support is built into
             flyway-core itself (org.flywaydb.core.internal.database.sqlite.*) - no separate
             database module needed. Do NOT add flyway-database-nc-sqlite: it pulls in
             flyway-nc-core, a parallel "Native Connectors" engine with a different API that
             classic FlywayAutoConfiguration does not drive, and having both on the classpath
             at once makes autoconfiguration silently skip migration instead of erroring. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!-- Explicit "win" classifier (M9): without it, Maven Central resolves org.openjfx
             artifacts to an empty placeholder jar (a few hundred bytes, no native code) -
             `mvn javafx:run` never notices because that plugin resolves its own classpath
             independently, but anything that packages the plain dependency graph (the fat
             jar spring-boot-maven-plugin builds below, and therefore jpackage) would ship
             a build that fails at startup with UnsatisfiedLinkError on a real machine. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- The base look for every JavaFX control (M10). Replaces JavaFX's stock "Modena"
             user-agent stylesheet wholesale via Application.setUserAgentStylesheet, which is
             what makes it style the Alert/Dialog instances created in Java too - those build
             their own Scene on show and so never picked up our scene-level app.css. MIT
             licensed, platform-independent (no classifier), and pure CSS: it adds no native
             code and needs no extra jlink module in scripts/package-windows.ps1. Our own
             app.css stays layered on top for app-specific pieces only. -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- FR-BAK-08: Windows DPAPI, scoped to the current Windows user, for the Drive
             refresh token and (see BackupService/SetupService) the backup password itself.
             jna-platform's Crypt32Util wraps CryptProtectData/CryptUnprotectData directly -
             no hand-written JNI needed. -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- FR-BAK-07/08: Google Drive API v3 + the OAuth 2.0 desktop loopback flow.
             google-oauth-client-jetty supplies LocalServerReceiver, the standard way a
             desktop app receives the OAuth redirect without a real web server. -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>${google-api-client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.oauth-client</groupId>
            <artifactId>google-oauth-client-jetty</artifactId>
            <version>${google-oauth-client.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-drive</artifactId>
            <version>${google-api-services-drive.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>furniture-ims</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Dev-loop runner: `mvn javafx:run`. Resolves platform-specific JavaFX natives
                 and puts them on the module path correctly for a fast local run/debug cycle. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.furnitureims.Launcher</mainClass>
                    <launcher>furniture-ims</launcher>
                </configuration>
            </plugin>

            <!-- `mvn package` now produces a real executable fat jar (target/furniture-ims.jar) -
                 every dependency, including the "win"-classified JavaFX jars fixed above, nested
                 inside via Spring Boot's own loader, entry point com.furnitureims.Launcher rather
                 than FurnitureImsApplication (which has no main()). This fat jar is the input
                 scripts/package-windows.ps1 feeds to jlink + jpackage to build the Windows
                 installer (NFR-02, milestone M9) - see that script for why jlink only needs to
                 supply java.desktop and friends, not the JavaFX modules themselves: this app runs
                 JavaFX in classpath (non-modular) mode, the same way `mvn javafx:run` already does. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.furnitureims.Launcher</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
